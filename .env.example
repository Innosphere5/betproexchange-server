# OddsPapi & Sportmonks API Keys
ODDS_API_KEY=your_oddspapi_v5_api_key_here
SPORTMONKS_API_KEY=your_sportmonks_api_key_here
API_KEY=your_api_key_here

# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/betpro?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Server Port (default 5000)
PORT=5000

# Schedule Window Timezone Offset (minutes east of UTC; 300 = PKT UTC+5)
APP_TIMEZONE_OFFSET_MINUTES=300

# Supabase PostgreSQL (Relational Archive, 24h Results, Financial Ledger & JWKS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
